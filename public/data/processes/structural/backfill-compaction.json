{
  "id": "backfill-compaction",
  "name_zh": "回填及壓實",
  "name_en": "Backfill and Compaction",
  "category": "structural",
  "ra_references": [
    "RA06 - A203A"
  ],
  "risk_matrix": {
    "lr_scale": [
      1,
      2,
      3,
      4,
      5
    ],
    "cr_scale": [
      "A",
      "B",
      "C",
      "D",
      "E"
    ],
    "risk_levels": {
      "I": "不可接受",
      "II": "可接受（需控制）",
      "III": "可忽略"
    }
  },
  "work_steps": [
    {
      "step": "1",
      "hazards": [
        {
          "hazard": "不適合現場環境工作",
          "affect": "W,P,E,A",
          "lr": 2,
          "cr": "D",
          "risk_level": "II",
          "control_measures": [
            "1.挖土機的挖掘容量必須符合實際需要。",
            "2.挖土機的體積必須符合實際需要。",
            "3.選擇履帶式挖土機於泥面工作，或膠帶式挖土機於石矢面工作。",
            "4.選擇全新挖土機或二手挖土機，必須符合實際需要。",
            "5. 選擇性能良好的挖土機使用。"
          ]
        }
      ]
    },
    {
      "step": "2",
      "hazards": [
        {
          "hazard": "扭傷 / 絆倒",
          "affect": "W,P,E,A",
          "lr": 3,
          "cr": "D",
          "risk_level": "II",
          "control_measures": [
            "1.提供認識正確提舉重物姿勢之訓練。",
            "2.安排足夠人手進行物料搬運,以減少個人勞動。",
            "3.保持通道暢通。",
            "4.必須每日清理垃圾及雜物，避免積聚。",
            "5.配戴保護手套，穿著安全鞋。"
          ]
        }
      ]
    },
    {
      "step": "3",
      "hazards": [
        {
          "hazard": "遭車輛/機械碰到",
          "affect": "W,P,E,A",
          "lr": 3,
          "cr": "E",
          "risk_level": "I",
          "control_measures": [
            "1.安裝倒車視像裝置，使司機及操作員可透過安裝於駕駛艙內的顯示屏，和安裝於車尾的閉路電視攝影機看到車輛後面情況",
            "2.機械安裝凸面照地鏡、泊車感應器及倒車警號及警示燈。",
            "3.劃定行人及行車路線(人車分路)",
            "4.安排工人指揮交通，帶領車輛進出工作地點。",
            "5.工人須穿著反光衣"
          ]
        }
      ]
    },
    {
      "step": "4",
      "hazards": [
        {
          "hazard": "被挖土機撞到",
          "affect": "W,P,E,A",
          "lr": 2,
          "cr": "D",
          "risk_level": "II",
          "control_measures": [
            "1. 挖土機須由持牌人仕操作",
            "2.左右兩邊須配置倒後鏡，每次轉動時，操作員須留意機傍的情況",
            "3. 挖掘時須圍封挖掘範圍，並貼上警告標示。",
            "4.安裝後視鏡頭及倒車感應警報器。",
            "2. 每週須由合資格人仕進行檢查",
            "3.挖土機操作員在挖掘前須先查察工作地點，以確定該處是適合擺放挖土機",
            "4. 行機時應盡量把挖斗放下。"
          ]
        },
        {
          "hazard": "挖土機翻倒",
          "affect": "W,P,E,A",
          "lr": 2,
          "cr": "D",
          "risk_level": "II",
          "control_measures": [
            "1. 挖土機須經法定的測試及檢查"
          ]
        }
      ]
    },
    {
      "step": "5",
      "hazards": [
        {
          "hazard": "進行體力處理操作\n導致絆倒/滑倒/扭傷",
          "affect": "W,P,E,A",
          "lr": 2,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "1.使用正確之搬運物件姿勢及方法。",
            "2.安排足夠人手協助或機械輔助搬運。",
            "3.每日收工前將垃圾清理，保持通道整潔暢通。",
            "4.在光線不足地方提供照明。",
            "5.妥善分配人手，安排更多休息時間予工人。",
            "6.工人每日開工前進行伸展運動。"
          ]
        }
      ]
    },
    {
      "step": "6",
      "hazards": [
        {
          "hazard": "吊機車倒塌",
          "affect": "W,P,E,A",
          "lr": 3,
          "cr": "E",
          "risk_level": "I",
          "control_measures": [
            "吊機車必須要設有自動安全負重顯示，負重範圍顯示及附有視聽警報系統的移動限制按鈕並安裝穩妥以確保安全操作",
            "吊機車上需清楚顯示安全操作負重並任何情況下吊運時不得超過其所指明的安全操作負重。",
            "吊機車操作員須於建造業議會訓練學院接受適當訓練及取得證書",
            "所有吊機車在使用前須進行測試及檢驗，並於每12個月內進行檢驗。",
            "合資格人士須最少每週檢查吊機車並簽署表格",
            "委任合資格的吊運員以操控及監管吊運工作。",
            "委派訊號員，在進行吊運時能夠與吊機車操作員通訊",
            "若果遇到惡劣天氣時，吊運工作須被終止。"
          ]
        }
      ]
    },
    {
      "step": "7",
      "hazards": [
        {
          "hazard": "吊運失誤 - 物件下墮",
          "affect": "W,P,E,A",
          "lr": 3,
          "cr": "E",
          "risk_level": "I",
          "control_measures": [
            "所有吊運鉤須穩妥地裝上安全閂",
            "使用適當的起重工具作吊運工作",
            "使用合適的吊重工具以進行吊運工作，切勿超重。",
            "工人不得留在已起吊的物料之下",
            "如有需要，為每一位吊機車操作員的對講機設立直接的通訊頻道。",
            "委任聯絡員以控制吊運程序。",
            "為聯絡員、訊號員及吊機車操作員就吊運程序提供指定的訓練",
            "所有吊重工具須塗上指定顏色以作顏色識別標記。",
            "在每次進行吊所有吊重工具須被檢查以確保吊重工具沒有損壞。",
            "不可使用沒有經檢驗的吊重工具進行吊運工作。",
            "吊運操作員及埋碼手須受過適合的訓練。",
            "吊運工作進行前，埋碼手須檢視每個吊重點。",
            "圍封施工的位置，並加上告示，禁止任何人士進入。"
          ]
        },
        {
          "hazard": "吊運物與吊運工具解體 - 物件下墮",
          "affect": "W,P,E,A",
          "lr": 3,
          "cr": "E",
          "risk_level": "I",
          "control_measures": [
            "所有供吊重工具必須持有由合資格檢驗人員發出的有效証明書。"
          ]
        },
        {
          "hazard": "超重 - 物件下墮",
          "affect": "W,P,E,A",
          "lr": 3,
          "cr": "E",
          "risk_level": "I",
          "control_measures": [
            "使用合適的吊重工具以進行吊運工作，切勿超重。",
            "吊運操作員及埋碼手須受過適合的訓練。",
            "確保物料沒有高於物料斗",
            "所有吊重裝置必須持有由合資格人士發出的有效檢驗證書。",
            "吊運區須使用聽覺警示，提醒吊運工作正在進行。"
          ]
        },
        {
          "hazard": "溝通不足引致吊運失誤",
          "affect": "W,P,E,A",
          "lr": 3,
          "cr": "E",
          "risk_level": "I",
          "control_measures": [
            "如有需要提供對講機以供吊機車操作員及埋碼手之間的溝通之用。"
          ]
        }
      ]
    },
    {
      "step": "8",
      "hazards": [
        {
          "hazard": "不適合現場環境工作",
          "affect": "W,P,E,A",
          "lr": 2,
          "cr": "D",
          "risk_level": "II",
          "control_measures": [
            "1.壓土機效能及馬力須符合實際工作性質。",
            "2.選擇全新壓土機或二手壓土機，必須符合實際需要",
            "3.選擇性能良好及配備全部所需的安全裝置和保護系統的壓土機使用。",
            "4.選擇壓土機時須考慮保養服務能否配合工作情況及環境。"
          ]
        }
      ]
    },
    {
      "step": "9",
      "hazards": [
        {
          "hazard": "被壓土機撞倒",
          "affect": "W,P,E,A",
          "lr": 3,
          "cr": "D",
          "risk_level": "II",
          "control_measures": [
            "1.進行壓土時須圍封工作範圍，並貼上警告標示。",
            "2.每次轉動時，操作員須留意機傍的情況。",
            "3.操作之人士需曾正式受過訓練。",
            "2.工人須配戴認可之聽覺保護罩。"
          ]
        },
        {
          "hazard": "壓土機發出的噪音影響聽覺",
          "affect": "W,P,E,A",
          "lr": 3,
          "cr": "B",
          "risk_level": "II",
          "control_measures": [
            "1.為工序進行噪音評估，並設立噪音區。"
          ]
        }
      ]
    },
    {
      "step": "10",
      "hazards": [
        {
          "hazard": "長時間曝曬缺水",
          "affect": "W,P,E,A",
          "lr": 2,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "1.員工開工必須穿著長袖衣服保護。",
            "2.帶備足夠飲用開工。",
            "3.定時飲水補充水份，定立小休時段。",
            "4.建造可避暑遮陰蔭的有蓋臨時地點。",
            "5.盡量飲用冰涼飲料以作降溫。"
          ]
        }
      ]
    }
  ]
}