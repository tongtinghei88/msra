{
  "id": "bamboo-scaffolding",
  "name_zh": "搭建及使用竹棚架",
  "name_en": "Bamboo Scaffolding Erection & Use",
  "category": "others",
  "ra_references": [],
  "risk_matrix": {
    "lr_scale": [1, 2, 3, 4, 5],
    "cr_scale": ["A", "B", "C", "D", "E"],
    "risk_levels": {
      "I": "不可接受",
      "II": "可接受（需控制）",
      "III": "可忽略"
    }
  },
  "work_steps": [
    {
      "step": "監管搭建竹棚",
      "hazards": [
        {
          "hazard": "缺乏監督引致意外",
          "affect": "W,P,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "須委任合資格人士監督搭建及拆卸竹棚架",
            "合資格人士須在場全程監督施工"
          ]
        }
      ]
    },
    {
      "step": "搭建前溝通及準備",
      "hazards": [
        {
          "hazard": "缺乏溝通/準備引致意外",
          "affect": "W,P,A",
          "lr": 3,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "搭建前須向所有工人講解施工方案及安全措施",
            "搭建前須進行場地視察，了解周邊環境及潛在危險",
            "設立圍封及警告標示，防止非工作人員進入施工範圍"
          ]
        }
      ]
    },
    {
      "step": "檢查竹棚物料",
      "hazards": [
        {
          "hazard": "使用不合適物料引致倒塌",
          "affect": "W,P,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "直杆及大橫杆直徑必須≥75mm，厚度≥10mm",
            "小橫杆/斜杆直徑必須≥40mm",
            "竹材須無裂紋、蟲蛀或腐爛",
            "竹材須經防蟲處理",
            "竹材存放須離地、通風及遮蓋"
          ]
        }
      ]
    },
    {
      "step": "選擇工作人員",
      "hazards": [
        {
          "hazard": "無經驗工人引致意外",
          "affect": "W,P,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "祇可由受過訓練及有經驗的搭棚工人搭建竹棚架",
            "搭棚工人須持有有效證書"
          ]
        }
      ]
    },
    {
      "step": "搭建竹棚 (安裝九臂架+搭建主架+鋪設棚網+安裝斜棚+鋪設工作台+搭建通道)",
      "hazards": [
        {
          "hazard": "棚架倒塌",
          "affect": "W,P,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "棚架高於15米須由專業工程師設計",
            "高於7米須設置連牆器",
            "棚架必須安全地支撐於穩固基礎上",
            "使用合適的竹材，確保直徑及厚度符合要求",
            "竹與竹之間須用合格的竹篾縛緊",
            "搭建途中不可移走任何支撐或連牆器",
            "不可在棚架上存放過多竹材或物料"
          ]
        },
        {
          "hazard": "人體下墮",
          "affect": "W,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "工人須配戴合適安全帶及扣於獨立救生繩上",
            "工作平台須安裝不少於900mm高的護欄，及不少於200mm高的踢腳板",
            "提供安全進出通道",
            "搭建位置下方須設置安全網",
            "提供足夠的工作台/功夫櫈進行工作"
          ]
        },
        {
          "hazard": "高空墜物",
          "affect": "W,P,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "搭建位置下方須圍封及設置警告牌",
            "安裝踢腳板防止物件下墮",
            "搭建期間須把竹材和工具妥善存放，避免墮下",
            "2幅圍網交疊距離≥300mm"
          ]
        },
        {
          "hazard": "中暑",
          "affect": "W,A",
          "lr": 3,
          "cr": "D",
          "risk_level": "III",
          "control_measures": [
            "地盤提供足夠飲用水",
            "提供臨時遮陰設施（太陽傘、帆布）",
            "上午及下午均指明小休時間",
            "提供足夠通風散熱風機"
          ]
        },
        {
          "hazard": "石矢塵粉/噪音/眼傷 (安裝九臂架時)",
          "affect": "W,A",
          "lr": 3,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "配戴認可的防塵口罩",
            "配戴認可的護眼罩",
            "配戴認可的聽覺保護器"
          ]
        }
      ]
    },
    {
      "step": "竹棚搭建完成後檢查",
      "hazards": [
        {
          "hazard": "缺乏檢查引致倒塌",
          "affect": "W,P,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "搭建完成後必須由合資格人士檢查，簽署Form 5後方可使用",
            "每14天必須由合資格人士重新檢查及簽署Form 5",
            "檢查記錄須張貼於棚架當眼位置"
          ]
        }
      ]
    },
    {
      "step": "惡劣天氣前後檢查",
      "hazards": [
        {
          "hazard": "缺乏檢查引致倒塌",
          "affect": "W,P,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "惡劣天氣（颱風、暴雨）前後必須由合資格人士檢查棚架穩定性",
            "檢查後如有損壞須即時維修",
            "檢查合格後方可繼續使用",
            "檢查記錄須保存備查"
          ]
        }
      ]
    }
  ]
}
