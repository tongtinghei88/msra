{
  "id": "abrasive-wheels",
  "name_zh": "使用砂輪 (座地及手提鎅機)",
  "name_en": "Abrasive Wheels (Bench & Portable)",
  "category": "others",
  "ra_references": [],
  "risk_matrix": {
    "lr_scale": [1, 2, 3, 4, 5],
    "cr_scale": ["A", "B", "C", "D", "E"],
    "risk_levels": {
      "I": "不可接受",
      "II": "可接受（需控制）",
      "III": "可忽略"
    }
  },
  "work_steps": [
    {
      "step": "操作座地鎅機及更換鎅碟",
      "hazards": [
        {
          "hazard": "轉動鎅碟割傷手部",
          "affect": "W,A",
          "lr": 3,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "鎅機必須裝有活動護罩",
            "禁止將活動護罩卡著方便操作",
            "護罩有損毁須維修後方可繼續操作",
            "操作鎅機時不應配戴棉紗手套，可改用皮手套",
            "保持地板平坦及不滑溜",
            "切割的物料須穩固於座地鎅機，嚴禁用手抓緊切割物"
          ]
        },
        {
          "hazard": "身體接觸/衣物纏繞砂輪",
          "affect": "W,A",
          "lr": 3,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "鎅機須安裝安全護罩，並確保護罩沒有受到干擾",
            "砂輪操作者穿著貼身衣物",
            "操作鎅機時不應用棉紗手套，可改用皮手套"
          ]
        },
        {
          "hazard": "錯誤選用及安裝鎅碟引致爆碟",
          "affect": "W,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "按照實際需要選擇適當磨碟",
            "磨輪不應安裝在非專為配合該用途而設的機械上",
            "由東主書面指定，袛可由受過訓練及有實際經驗的人負責安裝鎅碟",
            "安裝前進行「鳴聲」試驗",
            "張貼經批准的警告告示於工地內",
            "展示鎅機和鎅碟之最高容許轉速",
            "不要站在鎅機的正面開動機器，讓鎅機轉動大約一分鐘後才開始使用",
            "磨輪應合適地安裝在心軸上"
          ]
        },
        {
          "hazard": "切割碎片/火花彈傷眼睛",
          "affect": "W,A",
          "lr": 3,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "機械必須於適當位置裝有防護罩並調校妥當",
            "應戴上可抵受猛烈撞擊的護目鏡或面盾"
          ]
        },
        {
          "hazard": "錯誤操作鎅碟引致爆碟",
          "affect": "W,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "禁止使用座地鎅機作打磨用途",
            "必須使用合適磨輪作打磨用途",
            "未經訓練，必勿開動磨機",
            "嚴禁對磨輪突然加壓力",
            "如發現磨機有任何毛病或不尋常跡象，應即時停止使用及通知管工",
            "戴上可抵受猛烈撞擊的護目鏡或面盾"
          ]
        },
        {
          "hazard": "觸電",
          "affect": "W,A",
          "lr": 2,
          "cr": "E",
          "risk_level": "II",
          "control_measures": [
            "必須使用防水型號插頭",
            "電線必須高掛使用",
            "定期由合資格人士進行檢查及保養"
          ]
        },
        {
          "hazard": "噪音導致失聰",
          "affect": "W,A",
          "lr": 3,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "配戴認可的聽覺保護器",
            "盡可能減少連續使用時間，安排幾名工友輪流操作"
          ]
        },
        {
          "hazard": "吸入粉塵",
          "affect": "W,A",
          "lr": 3,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "配戴合適的防塵口罩/呼吸保護器",
            "如在室內位置操作，應使用合適的抽風設備"
          ]
        },
        {
          "hazard": "火花引發火警",
          "affect": "W,P,A",
          "lr": 3,
          "cr": "C",
          "risk_level": "II",
          "control_measures": [
            "要用合適擋板防止火花四散",
            "工作場所須配置滅火筒",
            "操作場地要移除可燃物料和廢料",
            "定時清理場地"
          ]
        }
      ]
    },
